# ---------------------------------------------------------------------------
# NexCore Backend — environment variables (NAMES ONLY).
# Copy to backend/.env and fill in locally. Never commit backend/.env.
# None of these are ever sent to a browser.
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Point at the SAME database as the Prisma
# schema in ../prisma. A "postgresql://" URL is accepted and rewritten to the
# async driver; a "?schema=" query param is stripped (set search_path instead).
DATABASE_URL=

# Shared secret for server-to-server calls from the Next.js admin panel.
# Must equal the panel's ADMIN_SERVICE_SECRET. Sent as the X-Service-Token
# header and compared in constant time. Generate: openssl rand -base64 32
ADMIN_SERVICE_SECRET=

# Seconds an unfinished (reserved / IN_PROGRESS) session keeps counting
# against quota before it is treated as abandoned. Default: 7200 (2h).
SESSION_RESERVATION_TTL_SECONDS=7200

# Reservation size used when a caller starts a session without an estimate.
# Default: 300 (5 min).
DEFAULT_ESTIMATED_SESSION_SECONDS=300
