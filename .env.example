# ---------------------------------------------------------------------------
# NexCore Super Admin — Environment Variables (NAMES ONLY)
# Copy to `.env` and fill in real values locally. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma
DATABASE_URL=

# Auth.js secret — signs/encrypts the session JWT.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of the app. Optional locally; set in production if the
# deployment platform does not provide it automatically.
AUTH_URL=

# ---------------------------------------------------------------------------
# First Super Admin bootstrap — consumed ONLY by `npm run admin:create`.
# Leave blank to be prompted interactively (password input is masked).
# These are never read by the running app and must never be committed.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Application
NEXT_PUBLIC_APP_NAME=

# ---------------------------------------------------------------------------
# NexCore backend (Python/FastAPI) — server-to-server ONLY.
# Read exclusively in server code (no NEXT_PUBLIC_ prefix); never sent to a
# browser. Leave blank to disable the live enforcement check in the UI.
# ---------------------------------------------------------------------------

# Base URL of the NexCore backend service, e.g. http://127.0.0.1:8000
NEXCORE_BACKEND_URL=

# Shared secret sent as the `X-Service-Token` header on backend calls.
# Must equal the backend's ADMIN_SERVICE_SECRET. Generate with:
#   openssl rand -base64 32
ADMIN_SERVICE_SECRET=
