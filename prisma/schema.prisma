// NexCore Super Admin — Prisma schema (Phase 2)
//
// PostgreSQL data model for the NexCore core + the AI Receptionist product.
// Product-specific quotas live in SubscriptionEntitlement (not on Product),
// so future products can define their own entitlements without a schema change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums — every enum is open for extension: add values in a later migration
// without touching existing rows.
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  // ADMIN, SUPPORT, BILLING, ... added in later phases
}

enum ClientStatus {
  ACTIVE
  SUSPENDED
  // Soft-deleted / offboarded. Historical billing + usage rows are kept
  // (Subscription / CallLog FKs are ON DELETE RESTRICT), so a client is
  // retired by moving it here rather than being physically deleted.
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  // Product-level "service off" switch, toggled from a product module
  // (e.g. AI Receptionist) without touching the core Client record.
  SUSPENDED
}

enum CallStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
  MISSED
}

enum AuditAction {
  CLIENT_CREATED
  CLIENT_UPDATED
  CLIENT_SUSPENDED
  CLIENT_ACTIVATED
  CLIENT_DEACTIVATED
  QUOTA_UPDATED
  SUBSCRIPTION_CHANGED
  // extend with PRODUCT_*, USER_* actions later
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id    String @id @default(cuid())
  name  String
  email String @unique

  /// bcrypt hash. Null = account exists but cannot sign in with a password
  /// yet (e.g. created record-only, or provisioned for a future SSO flow).
  passwordHash String?

  role      UserRole @default(SUPER_ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs AuditLog[]

  @@index([role])
}

// ---------------------------------------------------------------------------
// Tenants
// ---------------------------------------------------------------------------

model Client {
  id String @id @default(cuid())

  /// Human-facing internal identifier, e.g. "NC-CL-000001".
  /// Generated by a Postgres sequence (see the init migration) so it is
  /// gap-free, unique, and never depends on application code.
  clientId String @unique @default(dbgenerated("concat('NC-CL-', lpad((nextval('client_number_seq'))::text, 6, '0'))"))

  name      String
  website   String?
  domain    String?
  status    ClientStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  subscriptions Subscription[]
  callLogs      CallLog[]

  @@index([status])
  @@index([domain])
}

// ---------------------------------------------------------------------------
// Product catalogue
// ---------------------------------------------------------------------------

model Product {
  id          String        @id @default(cuid())
  key         String        @unique
  name        String
  description String?
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subscriptions Subscription[]

  @@index([status])
}

// ---------------------------------------------------------------------------
// Subscriptions + flexible entitlements
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id @default(cuid())
  clientId           String
  productId          String
  status             SubscriptionStatus @default(ACTIVE)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Restrict: a client/product with subscriptions cannot be hard-deleted.
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  entitlements SubscriptionEntitlement[]
  callLogs     CallLog[]

  @@index([clientId])
  @@index([productId])
  @@index([status])
  @@index([clientId, productId])
  @@index([billingPeriodEnd])
}

/// Key/value entitlements attached to a subscription. Each product decides
/// which keys it uses. AI Receptionist uses key = "monthly_talk_time_minutes"
/// stored in `intValue` (integer minutes — never floating point).
model SubscriptionEntitlement {
  id             String   @id @default(cuid())
  subscriptionId String
  key            String
  intValue       Int?
  stringValue    String?
  boolValue      Boolean?
  jsonValue      Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([subscriptionId, key])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Usage — append-only history. Never cascade-deleted.
// ---------------------------------------------------------------------------

model CallLog {
  id             String @id @default(cuid())
  clientId       String
  subscriptionId String

  /// Provider-side unique call identifier.
  callId String @unique

  startedAt DateTime
  endedAt   DateTime?

  /// Authoritative usage value for billing. Integer seconds only —
  /// minutes are derived for display, never used for calculations.
  durationSeconds Int        @default(0)
  status          CallStatus @default(COMPLETED)
  createdAt       DateTime   @default(now())

  // Restrict + no cascade: historical usage survives client/subscription changes.
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientId])
  @@index([subscriptionId])
  @@index([startedAt])
  @@index([clientId, startedAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit trail — append-only. Preserved even if the acting admin is removed.
// ---------------------------------------------------------------------------

model AuditLog {
  id          String      @id @default(cuid())
  adminUserId String
  action      AuditAction
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime    @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([adminUserId])
  @@index([createdAt])
  @@index([action])
  @@index([targetType, targetId])
}
